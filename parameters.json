{
  "run": {
    "seed": 42,
    "timezone": "UTC",
    "fail_fast": true,
    "production_cutoff": null
  },
  "data": {
    "asset_class": "crypto",
    "universe_name": "binance_daily",
    "top_n_symbols": 40,
